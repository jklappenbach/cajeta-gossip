{
    // cajeta-gossip — SWIM cluster membership + epidemic dissemination,
    // built ON the stdlib transport layer `cajeta.io.net` (UdpSocket,
    // reactor; multicast later for discovery).
    //
    // Gossip is an APPLICATION-layer protocol (probe cadence, suspicion
    // policy, dissemination strategy), not a transport primitive — so it
    // ships as a LIBRARY, the same relationship dev.cajeta.http has to
    // the stdlib. See docs/CajetaGossip.md.
    //
    // A LIBRARY project: no `entry-method`, compiles to a reusable `.cja`.

    "details": {
        "name":                "dev.cajeta.gossip",
        "version":             "0.1.0",
        "description":         "SWIM-style cluster membership and epidemic dissemination over cajeta.io.net UDP",
        "license":             "Apache-2.0",
        "authors":             ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // Compiler build this library is developed against (distinct from
        // cajeta-lang-version, which pins the language/stdlib API surface).
        // 0.9.2 is the first toolchain with the library archetype + the
        // external-library ecosystem (dev.cajeta.http precedent).
        "toolchain": {
            "version": "0.9.4"
        },

        // The full library needs UDP sockets; capabilities are re-validated
        // against the consuming project's manifest at the point of use, so a
        // consumer must also declare "network" to call the socket-touching
        // surface (Cluster.join). Pure parts (wire codec, membership core)
        // stay usable without it.
        "capabilities": ["network"],

        // The core stdlib (cajeta.lang, cajeta.io, cajeta.io.net, …) is
        // built into the toolchain — not declared, not fetched.
        "dependencies": {},

        // Empty: the suite is a self-checking binary under test/src (its own
        // Check helper, no framework). The starter's `cajeta.testkit`
        // placeholder named a package that exists in no repository.
        "dev-dependencies": {},

        "repositories": [
            // olla.cajeta.dev — repo.cajeta.org (the starter default) is NXDOMAIN.
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        // NO `entry-method` — this is a library; the build emits a .cja.
        "build": {
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            // The suite is an ordinary self-checking binary — test/src
            // compiled against the built .cja via --classpath; exit 0 iff
            // every check passes. Self-contained and machine-independent,
            // so CI runs this task directly (`cajeta test`).
            "description": "Build + run the library's unit tests",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" },
                { "action": "exec", "command": "cajeta",
                  "args": [ "dev.cajeta.gossip.test.TestMain::main",
                            "test/src", "build/test",
                            "--emit=exe", "--classpath=${art.path}",
                            "-o", "build/test/gossip-tests" ] },
                { "action": "test", "input": "build/test/gossip-tests" }
            ]
        },

        "release": {
            "description": "Optimized release build of the library (.cja)",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
