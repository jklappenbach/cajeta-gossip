package dev.cajeta.gossip.test;

// Entry point for the library's self-checking test binary (see the
// manifest's `test` task). Exit 0 iff every check passes.
public final class TestMain {
    public static int32 main(String[] args) {
        System.stdout.println("=== dev.cajeta.gossip tests ===");
        Check c = heap Check();

        GossipWireTests.run(c);
        GossipMembershipTests.run(c);
        GossipTransportTests.run(c);
        GossipJoinLeaveTests.run(c);
        GossipDisseminationTests.run(c);
        GossipClusterTests.run(c);

        System.stdout.println("");
        System.stdout.println("=== {} passed, {} failed ===",
                              c.passes, c.failures);
        if (c.failures > 0) {
            return 1;
        }
        return 0;
    }
}
