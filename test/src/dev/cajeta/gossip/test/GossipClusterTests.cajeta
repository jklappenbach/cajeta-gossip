package dev.cajeta.gossip.test;

import dev.cajeta.gossip.GossipNode;
import dev.cajeta.gossip.Member;
import dev.cajeta.gossip.MemberState;
import dev.cajeta.gossip.MembershipEvent;
import dev.cajeta.gossip.EventKind;
import cajeta.concurrent.Tasks;

// G6 — cluster convergence + failure detection (plan §1.f). The capstone:
// staggered joins under live probe traffic, then a killed node detected
// DEAD via the events log at every survivor with no false positives for
// the living (whose defense is the SWIM refutation: a node that hears
// itself suspected bumps its incarnation and re-announces ALIVE).
public final class GossipClusterTests {

    public static async void runNode(GossipNode n) {
        n.receiveLoop();
    }

    public static async void runLoop(GossipNode n) {
        n.protocolLoop(50);
    }

    public static void run(Check c) {
        System.stdout.println("GossipClusterTests");
        nNodeConverges(c);
        deadDetectedNoFalsePositive(c);
    }

    // True iff `n` knows all four of the given names as ALIVE.
    private static boolean knowsAllAlive(GossipNode n, String a, String b,
                                         String x, String y) {
        Member ma = n.table().get(a);
        Member mb = n.table().get(b);
        Member mx = n.table().get(x);
        Member my = n.table().get(y);
        if (ma == null || ma.state != MemberState.ALIVE) { return false; }
        if (mb == null || mb.state != MemberState.ALIVE) { return false; }
        if (mx == null || mx.state != MemberState.ALIVE) { return false; }
        if (my == null || my.state != MemberState.ALIVE) { return false; }
        return true;
    }

    // §1.f.1 — five nodes, protocol loops live from the start, STAGGERED
    // joins (each lands while earlier members are already probing); the
    // full N×(N-1) ALIVE matrix converges within the window.
    public static void nNodeConverges(Check c) {
        () -> int32 body = () -> {
            GossipNode n0 = heap GossipNode("n0", 60000);
            GossipNode n1 = heap GossipNode("n1", 60000);
            GossipNode n2 = heap GossipNode("n2", 60000);
            GossipNode n3 = heap GossipNode("n3", 60000);
            GossipNode n4 = heap GossipNode("n4", 60000);
            int32 result = 0;
            scope {
                spawn runNode(n0);
                spawn runNode(n1);
                spawn runNode(n2);
                spawn runNode(n3);
                spawn runNode(n4);
                spawn runLoop(n0);
                spawn runLoop(n1);
                spawn runLoop(n2);
                spawn runLoop(n3);
                spawn runLoop(n4);
                boolean ok = n1.join(n0.port(), 1000);
                Tasks.sleepMillis(75);
                ok = ok && n2.join(n0.port(), 1000);
                Tasks.sleepMillis(75);
                ok = ok && n3.join(n1.port(), 1000);   // join via a non-seed
                Tasks.sleepMillis(75);
                ok = ok && n4.join(n2.port(), 1000);   // ditto
                if (!ok) {
                    result = 10;
                } else {
                    int32 waited = 0;
                    boolean done = false;
                    while (waited < 8000 && !done) {
                        done = knowsAllAlive(n0, "n1", "n2", "n3", "n4")
                            && knowsAllAlive(n1, "n0", "n2", "n3", "n4")
                            && knowsAllAlive(n2, "n0", "n1", "n3", "n4")
                            && knowsAllAlive(n3, "n0", "n1", "n2", "n4")
                            && knowsAllAlive(n4, "n0", "n1", "n2", "n3");
                        if (!done) {
                            Tasks.sleepMillis(50);
                            waited = waited + 50;
                        }
                    }
                    if (done) {
                        result = 1;
                    } else {
                        result = 11;
                    }
                }
                n0.stop();
                n1.stop();
                n2.stop();
                n3.stop();
                n4.stop();
            }
            return result;
        };
        int32 r = Tasks.runBlocking<int32>(body);
        c.eqInt(r, 1, "5-node staggered cluster converges (code " + r + ")");
    }

    // Count DEAD events in `n`'s log naming `who`.
    private static int32 deadEventsFor(GossipNode n, String who) {
        int32 count = 0;
        int32 i = 0;
        while (i < n.table().events.count()) {
            MembershipEvent e = n.table().events.get(i);
            if (e.kind == EventKind.DEAD && e.name.equals(who)) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    // §1.f.2 — kill one node of a converged four: every survivor reports
    // it DEAD via the events log within bounded time, and no survivor
    // ever records a DEAD event for a living node (transient SUSPECTs are
    // legal — the refutation clears them; a DEAD-for-alive is the false
    // positive this pins).
    public static void deadDetectedNoFalsePositive(Check c) {
        () -> int32 body = () -> {
            GossipNode n0 = heap GossipNode("n0", 400);
            GossipNode n1 = heap GossipNode("n1", 400);
            GossipNode n2 = heap GossipNode("n2", 400);
            GossipNode n3 = heap GossipNode("n3", 400);
            int32 result = 0;
            scope {
                spawn runNode(n0);
                spawn runNode(n1);
                spawn runNode(n2);
                spawn runNode(n3);
                boolean ok = n1.join(n0.port(), 1000);
                ok = ok && n2.join(n0.port(), 1000);
                ok = ok && n3.join(n0.port(), 1000);
                if (!ok) {
                    result = 10;
                } else {
                    spawn runLoop(n0);
                    spawn runLoop(n1);
                    spawn runLoop(n2);
                    spawn runLoop(n3);
                    // Let the cluster settle into probe traffic.
                    Tasks.sleepMillis(300);
                    // Kill n3.
                    n3.stop();
                    int32 waited = 0;
                    boolean allDead = false;
                    while (waited < 8000 && !allDead) {
                        allDead = deadEventsFor(n0, "n3") > 0
                               && deadEventsFor(n1, "n3") > 0
                               && deadEventsFor(n2, "n3") > 0;
                        if (!allDead) {
                            Tasks.sleepMillis(50);
                            waited = waited + 50;
                        }
                    }
                    if (!allDead) {
                        result = 11;               // kill not detected
                    } else if (deadEventsFor(n0, "n1") > 0
                            || deadEventsFor(n0, "n2") > 0
                            || deadEventsFor(n1, "n0") > 0
                            || deadEventsFor(n1, "n2") > 0
                            || deadEventsFor(n2, "n0") > 0
                            || deadEventsFor(n2, "n1") > 0) {
                        result = 12;               // false positive
                    } else {
                        Member s01 = n0.table().get("n1");
                        Member s12 = n1.table().get("n2");
                        Member s20 = n2.table().get("n0");
                        if (s01.state == MemberState.DEAD
                                || s12.state == MemberState.DEAD
                                || s20.state == MemberState.DEAD) {
                            result = 13;           // living marked dead
                        } else {
                            result = 1;
                        }
                    }
                }
                n0.stop();
                n1.stop();
                n2.stop();
            }
            return result;
        };
        int32 r = Tasks.runBlocking<int32>(body);
        c.eqInt(r, 1, "kill detected, no false positives (code " + r + ")");
    }
}
