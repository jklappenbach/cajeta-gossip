package dev.cajeta.gossip;

import cajeta.lang.Optional;
import cajeta.io.net.UdpSocket;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.IpAddress;
import cajeta.io.net.RecvResult;
import cajeta.concurrent.Tasks;
import cajeta.concurrent.Channel;
import cajeta.time.Duration;
import cajeta.time.Clock;
import cajeta.collection.ArrayList;

/**
 * G3 — the transport binding (spec § Runtime integration): one node's
 * [`UdpSocket`](../../../cajeta/io/net/UdpSocket.cajeta) +
 * [`MembershipTable`](MembershipTable.cajeta), a **receive fiber**
 * ([`receiveLoop`](#receiveLoop) — parks on the reactor between datagrams
 * via `recvFromAsync`), and the SWIM probe cycle
 * ([`probe`](#probe): direct `PING`, then `k` indirect `PING_REQ`s, then
 * suspicion).
 *
 * G3 scope notes:
 *   - Loopback-only addressing (`127.0.0.1:<port>` from the member entry's
 *     port) — real address plumbing from `Delta.addrHi/addrLo` lands with
 *     join/SYNC (G4).
 *   - `PING_REQ` receipt is recorded but not yet relayed (the helper
 *     probing the target on the origin's behalf is the G5 refinement);
 *     the ping-req fan-out and the suspicion verdict are G3's cycle.
 *   - Acks flow from the receive fiber to the prober through a
 *     [`Channel`](../../../cajeta/concurrent/Channel.cajeta), waited on
 *     under `Tasks.withTimeout` — no polling, no busy-spin.
 */
public final class GossipNode {
    public String name;
    public int64 incarnation;
    public UdpSocket sock;
    public int32 boundPort;
    public MembershipTable membership;
    /** Ack signals from the receive fiber to the prober — name HASHES
     *  (the Channel lends its slots, so borrowed Strings would dangle;
     *  primitives are safe by value). */
    public Channel<int64> acks;
    public WireWriter writer;
    /** The receive fiber's own writer — replies (ACK/SYNC) must not race
     *  the probe/broadcast fiber's frame under the default carrier pool. */
    public WireWriter rxWriter;
    /** Infection-style dissemination buffer (G5). */
    public PiggybackQueue piggyback;
    /** Received app payloads — the `messages()` surface (an owned inbox;
     *  `Channel` lends its slots, so heap payloads ride a list instead). */
    public ArrayList<UserMessage> inbox;
    /** How far the piggyback drain has read the table's event log. */
    public int32 eventsDrained;
    /** Deltas piggybacked per outgoing frame (spec default 3). */
    public int32 gossipFanout;
    public boolean running;
    /** `k` — indirect probes per failed direct probe (default 3). */
    public int32 indirectK;

    // G3 observability (pinned by GossipTransportTests).
    public int32 pingReqSeen;
    public String lastPingReqTarget;

    public GossipNode(String name, int64 suspectTimeoutMillis) {
        this.name = name;
        this.incarnation = 1;
        IpAddress lo = IpAddress.loopbackV4();
        SocketAddress bindAddr = SocketAddress.of(#lo, 0);
        this.sock = UdpSocket.bind(bindAddr);
        SocketAddress local = this.sock.localAddress();
        this.boundPort = local.getPort();
        this.membership = heap MembershipTable(suspectTimeoutMillis);
        this.acks = heap Channel<int64>(16);
        this.writer = heap WireWriter();
        this.rxWriter = heap WireWriter();
        this.piggyback = heap PiggybackQueue();
        this.inbox = heap ArrayList<UserMessage>();
        this.eventsDrained = 0;
        this.gossipFanout = 3;
        this.running = true;
        this.indirectK = 3;
        this.pingReqSeen = 0;
        this.lastPingReqTarget = "";
    }

    public int32 port() { return this.boundPort; }
    public MembershipTable table() { return this.membership; }

    /**
     * The receive fiber's body: park on the reactor until a datagram
     * arrives, decode, dispatch. Malformed frames are dropped (the view
     * constructor's validation throws; gossip is best-effort). Run it as
     * `spawn node.receiveLoop()`; unblock it with [`stop`](#stop).
     */
    /** `spawn` trampoline (spawn takes bare class-method calls only). */
    public static async void runReceiveLoop(GossipNode n) {
        n.receiveLoop();
    }

    public void receiveLoop() {
        int8[] buf = heap int8[1500];
        while (this.running) {
            RecvResult r = this.sock.recvFromAsync(buf, 0, 1500);
            if (!this.running) {
                return;
            }
            try {
                this.handleFrame(buf, r.getFrom());
            } catch (Exception e) {
                // malformed datagram — drop (best-effort protocol)
            }
        }
    }

    /** Stop the node: clears the flag and pokes the socket so a parked
     *  receive fiber wakes and exits. */
    public void stop() {
        this.running = false;
        int8[] poke = heap int8[1];
        poke[0] = (int8) 0;
        IpAddress lo = IpAddress.loopbackV4();
        SocketAddress self = SocketAddress.of(#lo, this.boundPort);
        this.sock.sendTo(poke, 0, 1, self);
    }

    /** Decode one frame and dispatch by message type. */
    public void handleFrame(int8[] buf, SocketAddress from) {
        GossipMessage m = GossipMessage(buf);
        if (m.magic != Wire.MAGIC) {
            return;
        }
        int8 t = m.msgType;
        String sender = m.senderName;
        if (t == Wire.PING) {
            // Pings carry piggybacked deltas — apply, then reply with an
            // ACK that piggybacks our own queue (the epidemic push-pull).
            this.applyDeltas(m);
            this.drainEvents();
            this.rxWriter.begin(Wire.ACK, this.name, this.incarnation);
            this.piggyback.fill(this.rxWriter, this.gossipFanout,
                                this.membership.names.count() + 1);
            int8[] ack = this.rxWriter.finish();
            this.sock.sendTo(ack, 0, (int32) ack.count(), from);
        } else if (t == Wire.ACK) {
            // Direct evidence of life: upsert the sender ALIVE and apply
            // whatever the ack piggybacked, then signal the prober.
            this.membership.applyAlive(sender, 0, 2130706433,
                                       from.getPort(), m.senderIncarnation);
            this.applyDeltas(m);
            this.drainEvents();
            this.acks.send(sender.hash());
        } else if (t == Wire.USER) {
            this.applyDeltas(m);
            this.drainEvents();
            int8[] pl = m.payload;
            UserMessage um = heap UserMessage(sender, pl, (int32) pl.count());
            this.inbox.add(#um);
        } else if (t == Wire.SYNC) {
            // Apply the snapshot's deltas, then answer a REQUEST (non-empty
            // payload marker) with our own snapshot — response payloads are
            // empty, so replies never re-reply (no sync storms).
            this.applyDeltas(m);
            this.drainEvents();
            int8[] marker = m.payload;
            if ((int32) marker.count() > 0) {
                this.sendSnapshot(from);
            }
        } else if (t == Wire.LEAVE) {
            this.membership.applyLeft(sender);
        } else if (t == Wire.PING_REQ) {
            // Recorded for G3; the relay (probe target on origin's behalf)
            // is the G5 refinement.
            this.pingReqSeen = this.pingReqSeen + 1;
            int8[] pl = m.payload;
            int32 n = (int32) pl.count();
            int8[] copy = heap int8[n];
            int32 i = 0;
            while (i < n) {
                copy[i] = pl[i];
                i = i + 1;
            }
            String tgt = heap String(#copy, n);
            this.lastPingReqTarget = #tgt;
        }
        // SYNC / LEAVE / USER: G4 / G5.
    }

    /** Apply every piggybacked delta of `m` to the membership table. */
    public void applyDeltas(GossipMessage m) {
        int32 n = (int32) m.deltas.count();
        int32 k = 0;
        while (k < n) {
            Delta d = m.deltas[k];
            String dn = d.name;
            if (!dn.equals(this.name)) {
                int8 st = d.state;
                if (st == (int8) MemberState.ALIVE) {
                    this.membership.applyAlive(dn, d.addrHi, d.addrLo,
                                               (int64) d.port, d.incarnation);
                } else if (st == (int8) MemberState.SUSPECT) {
                    this.membership.applySuspect(dn, d.incarnation, 0);
                } else if (st == (int8) MemberState.DEAD) {
                    this.membership.applyDead(dn, d.incarnation);
                } else if (st == (int8) MemberState.LEFT) {
                    this.membership.applyLeft(dn);
                }
            }
            k = k + 1;
        }
    }

    /** Build a member's socket address from its table entry (v4-mapped
     *  address word + port). */
    public #SocketAddress addrOf(Member m) {
        int32 v4 = (int32) m.addrLo;
        IpAddress ip = IpAddress.fromV4((v4 >> 24) & 255, (v4 >> 16) & 255,
                                        (v4 >> 8) & 255, v4 & 255);
        return SocketAddress.of(#ip, (int32) m.port);
    }

    /** SYNC snapshot to `dest`: our own delta first, then every ALIVE
     *  member, MTU-budgeted (addDelta stops accepting at the cap — the
     *  join-time sync is bounded by design; anti-entropy beyond it is out
     *  of scope for v1). Empty payload = response (never re-replied). */
    public void sendSnapshot(SocketAddress dest) {
        this.rxWriter.begin(Wire.SYNC, this.name, this.incarnation);
        this.rxWriter.addDelta((int8) MemberState.ALIVE, this.incarnation,
                               0, 2130706433, (int64) this.boundPort, this.name);
        int32 i = 0;
        while (i < this.membership.names.count()) {
            Member m = this.membership.get(this.membership.names.get(i));
            if (m.state == MemberState.ALIVE) {
                this.rxWriter.addDelta((int8) MemberState.ALIVE, m.incarnation,
                                       m.addrHi, m.addrLo, m.port, m.name);
            }
            i = i + 1;
        }
        int8[] frame = this.rxWriter.finish();
        this.sock.sendTo(frame, 0, (int32) frame.count(), dest);
    }

    /**
     * Join via a unicast seed at loopback `seedPort` (G4): send a SYNC
     * REQUEST (our own delta + a one-byte request marker payload) and wait
     * up to `timeoutMs` for the seed's snapshot to land — success = the
     * table grew. The seed learns us from our delta; we learn the seed and
     * everything it knew from the response.
     */
    public boolean join(int32 seedPort, int32 timeoutMs) {
        int32 before = this.membership.names.count();
        IpAddress lo = IpAddress.loopbackV4();
        SocketAddress dest = SocketAddress.of(#lo, seedPort);
        this.writer.begin(Wire.SYNC, this.name, this.incarnation);
        this.writer.addDelta((int8) MemberState.ALIVE, this.incarnation,
                             0, 2130706433, (int64) this.boundPort, this.name);
        int8[] req = heap int8[1];
        req[0] = (int8) 1;
        this.writer.setPayload(req);
        int8[] frame = this.writer.finish();
        this.sock.sendTo(frame, 0, (int32) frame.count(), dest);

        int32 waited = 0;
        while (waited < timeoutMs) {
            if (this.membership.names.count() > before) {
                return true;
            }
            Tasks.sleepMillis(5);
            waited = waited + 5;
        }
        return false;
    }

    /** Graceful departure: gossip a LEAVE to every ALIVE member. Peers
     *  mark us LEFT immediately — no suspicion round. */
    public void leave() {
        this.writer.begin(Wire.LEAVE, this.name, this.incarnation);
        int8[] frame = this.writer.finish();
        int32 i = 0;
        while (i < this.membership.names.count()) {
            Member m = this.membership.get(this.membership.names.get(i));
            if (m.state == MemberState.ALIVE) {
                SocketAddress dest = this.addrOf(m);
                this.sock.sendTo(frame, 0, (int32) frame.count(), dest);
            }
            i = i + 1;
        }
    }

    /**
     * Turn every new table event into a piggybacked delta — the single
     * bridge from state changes to the epidemic (JOINED/RECOVERED spread
     * as ALIVE, SUSPECTED as SUSPECT, DEAD as DEAD, LEFT as LEFT).
     */
    public void drainEvents() {
        while (this.eventsDrained < this.membership.events.count()) {
            MembershipEvent e = this.membership.events.get(this.eventsDrained);
            Member m = this.membership.get(e.name);
            if (m != null) {
                int8 st = (int8) MemberState.ALIVE;
                if (e.kind == EventKind.SUSPECTED) {
                    st = (int8) MemberState.SUSPECT;
                } else if (e.kind == EventKind.DEAD) {
                    st = (int8) MemberState.DEAD;
                } else if (e.kind == EventKind.LEFT) {
                    st = (int8) MemberState.LEFT;
                }
                this.piggyback.offer(st, m.incarnation, m.addrHi, m.addrLo,
                                     m.port, m.name);
            }
            this.eventsDrained = this.eventsDrained + 1;
        }
    }

    /**
     * The protocol-period fiber (spec § Runtime integration): every
     * `periodMs`, probe the next ALIVE member round-robin (the plan's
     * random selection is a follow-up — round-robin gives the same
     * coverage guarantee deterministically), advance suspicion timeouts,
     * and drain fresh events into the piggyback queue. Run as
     * `spawn <wrapper>(node)`; stops with [`stop`](#stop).
     */
    public void protocolLoop(int32 periodMs) {
        int32 idx = 0;
        while (this.running) {
            int32 n = this.membership.names.count();
            int32 tries = 0;
            boolean probed = false;
            while (tries < n && !probed && this.running) {
                idx = idx + 1;
                if (idx >= n) {
                    idx = 0;
                }
                String peer = this.membership.names.get(idx);
                Member m = this.membership.get(peer);
                if (m.state == MemberState.ALIVE) {
                    this.probe(peer, (int32) m.port, periodMs,
                               Clock.millisTime());
                    probed = true;
                }
                tries = tries + 1;
            }
            this.membership.tick(Clock.millisTime());
            this.drainEvents();
            Tasks.sleepMillis((int64) periodMs);
        }
    }

    /**
     * Gossip an app payload to the cluster: one `USER` frame (piggybacking
     * membership deltas like any other frame) sent to every ALIVE member.
     * Direct fan-out in v1 — epidemic relay of user messages (IDs + dedup)
     * is a post-v1 refinement.
     */
    public void broadcast(int8[] payload) {
        this.writer.begin(Wire.USER, this.name, this.incarnation);
        this.piggyback.fill(this.writer, this.gossipFanout,
                            this.membership.names.count() + 1);
        this.writer.setPayload(payload);
        int8[] frame = this.writer.finish();
        int32 i = 0;
        while (i < this.membership.names.count()) {
            Member m = this.membership.get(this.membership.names.get(i));
            if (m.state == MemberState.ALIVE) {
                SocketAddress dest = this.addrOf(m);
                this.sock.sendTo(frame, 0, (int32) frame.count(), dest);
            }
            i = i + 1;
        }
    }

    /**
     * One SWIM probe cycle against `target` at loopback `targetPort`:
     * direct `PING`, ack awaited `timeoutMs` under `Tasks.withTimeout`;
     * on miss, `k` `PING_REQ`s (payload = target name) to other live
     * members, one more ack window; still nothing → the failure
     * detector's verdict ([`MembershipTable.probeFailed`](MembershipTable.cajeta#probeFailed)
     * at `now`). Returns whether an ack for `target` arrived.
     */
    public boolean probe(String target, int32 targetPort, int32 timeoutMs,
                         int64 now) {
        IpAddress lo = IpAddress.loopbackV4();
        SocketAddress dest = SocketAddress.of(#lo, targetPort);
        this.writer.begin(Wire.PING, this.name, this.incarnation);
        this.piggyback.fill(this.writer, this.gossipFanout,
                            this.membership.names.count() + 1);
        int8[] ping = this.writer.finish();
        this.sock.sendTo(ping, 0, (int32) ping.count(), dest);

        if (this.awaitAckWithin(target, timeoutMs)) {
            return true;
        }

        // Indirect round: PING_REQ(target) to up to k other live members.
        int8[] targetBytes = target.toBytes();
        int32 sentReqs = 0;
        int32 i = 0;
        while (i < this.membership.names.count() && sentReqs < this.indirectK) {
            String peer = this.membership.names.get(i);
            if (!peer.equals(this.name) && !peer.equals(target)) {
                Member pm = this.membership.get(peer);
                if (pm.state == MemberState.ALIVE) {
                    this.writer.begin(Wire.PING_REQ, this.name, this.incarnation);
                    this.writer.setPayload(targetBytes);
                    int8[] req = this.writer.finish();
                    IpAddress plo = IpAddress.loopbackV4();
                    SocketAddress pdest = SocketAddress.of(#plo, (int32) pm.port);
                    this.sock.sendTo(req, 0, (int32) req.count(), pdest);
                    sentReqs = sentReqs + 1;
                }
            }
            i = i + 1;
        }

        if (sentReqs > 0 && this.awaitAckWithin(target, timeoutMs)) {
            return true;
        }
        this.membership.probeFailed(target, now);
        return false;
    }

    /**
     * Drain the ack channel until an ack for `target` arrives or
     * `timeoutMs` elapses. Bounded polling with a cooperative fiber sleep
     * ([`Tasks.sleepMillis`](../../../cajeta/concurrent/Tasks.cajeta#sleepMillis))
     * — `Tasks.withTimeout` cannot interrupt a fiber parked on
     * `Channel.receive`, so the probe window polls at 5ms granularity
     * instead (the receive fiber itself still parks on the reactor; only
     * an ACTIVE probe wait polls, and only for its window).
     */
    public boolean awaitAckWithin(String target, int32 timeoutMs) {
        int64 want = target.hash();
        int32 waited = 0;
        while (waited < timeoutMs) {
            Optional<int64> s = this.acks.tryReceive();
            if (s.isPresent()) {
                if (s.get() == want) {
                    return true;
                }
                // ack for someone else — keep draining this pass
            } else {
                Tasks.sleepMillis(5);
                waited = waited + 5;
            }
        }
        return false;
    }
}
