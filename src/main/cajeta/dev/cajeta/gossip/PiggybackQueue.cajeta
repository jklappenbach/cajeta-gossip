package dev.cajeta.gossip;

import cajeta.collection.ArrayList;

/**
 * The infection-style dissemination buffer (spec § How SWIM works): every
 * membership change enqueues one delta, and every outgoing frame carries
 * up to `gossipFanout` of them ([`fill`](#fill)) until each has ridden
 * roughly `λ·log₂(N)` frames ([`retransmitLimit`](#retransmitLimit),
 * λ = 3) — the epidemic budget that converges an update to all live nodes
 * with high probability in O(log N) protocol periods.
 *
 * Newest-wins per member: a fresh change for a name already queued
 * replaces the entry and resets its send count. Spent entries are skipped
 * (compaction of the retired tail is a follow-up — the queue grows with
 * total membership churn, not with traffic).
 */
public final class PiggybackQueue {
    public ArrayList<PiggybackEntry> entries;

    public PiggybackQueue() {
        this.entries = heap ArrayList<PiggybackEntry>();
    }

    /** Enqueue (or refresh) the delta for `name`. */
    public void offer(int8 state, int64 incarnation, int64 addrHi,
                      int64 addrLo, int64 port, String name) {
        int32 i = 0;
        while (i < this.entries.count()) {
            PiggybackEntry e = this.entries.get(i);
            if (e.name.equals(name)) {
                e.state = state;
                e.incarnation = incarnation;
                e.addrHi = addrHi;
                e.addrLo = addrLo;
                e.port = port;
                e.sends = 0;
                return;
            }
            i = i + 1;
        }
        PiggybackEntry fresh = heap PiggybackEntry(state, incarnation,
                                                   addrHi, addrLo, port, name);
        this.entries.add(#fresh);
    }

    /**
     * Ride up to `budget` unspent deltas on the frame being built in `w`
     * (stops early if the writer's MTU budget refuses one). `memberCount`
     * sizes the retransmit limit.
     */
    public void fill(WireWriter w, int32 budget, int32 memberCount) {
        int32 limit = PiggybackQueue.retransmitLimit(memberCount);
        int32 added = 0;
        int32 i = 0;
        while (i < this.entries.count() && added < budget) {
            PiggybackEntry e = this.entries.get(i);
            if (e.sends < limit) {
                if (w.addDelta(e.state, e.incarnation, e.addrHi, e.addrLo,
                               e.port, e.name)) {
                    e.sends = e.sends + 1;
                    added = added + 1;
                }
            }
            i = i + 1;
        }
    }

    /** `3·⌈log₂(max(n,2))⌉ + 1` — the λ·log N budget, λ = 3. */
    public static int32 retransmitLimit(int32 n) {
        int32 target = n;
        if (target < 2) {
            target = 2;
        }
        int32 l = 0;
        int32 v = 1;
        while (v < target) {
            v = v * 2;
            l = l + 1;
        }
        return 3 * l + 1;
    }
}
